#!/bin/bash

if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

if [[ -z "${DIB_VGPU_DRIVERS_URL:-}" ]]; then
    echo "Error: DIB_VGPU_DRIVERS_URL is not set"
    exit 1
fi

if [[ -z "${DIB_VGPU_CLIENT_TOKEN_FILE:-}" ]]; then
    echo "Error: DIB_VGPU_CLIENT_TOKEN_FILE is not set"
    exit 1
fi

if [[ ! -f "${DIB_VGPU_CLIENT_TOKEN_FILE}" ]]; then
    echo "Error: vGPU client token file not found at ${DIB_VGPU_CLIENT_TOKEN_FILE}"
    exit 1
fi

# Create cache directory if it doesn't exist
if [[ ! -d "${DIB_IMAGE_CACHE}/vgpu-drivers" ]]; then
    mkdir -p "${DIB_IMAGE_CACHE}/vgpu-drivers"
fi

# Extract filename from URL
filename=$(basename "${DIB_VGPU_DRIVERS_URL}")
cached_deb="${DIB_IMAGE_CACHE}/vgpu-drivers/${filename}"

if [[ ! -f "${cached_deb}" ]]; then
    echo "vGPU drivers DEB not cached. Downloading from ${DIB_VGPU_DRIVERS_URL}..."
    wget --show-progress -O "${cached_deb}" "${DIB_VGPU_DRIVERS_URL}"
fi

cp "${cached_deb}" "${TMP_HOOKS_PATH}"

# Stage the client configuration token as provided
cp "${DIB_VGPU_CLIENT_TOKEN_FILE}" "${TMP_HOOKS_PATH}/client_configuration_token.tok"
chmod 600 "${TMP_HOOKS_PATH}/client_configuration_token.tok"
